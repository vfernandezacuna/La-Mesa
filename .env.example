# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el script de seed (Fase 3), nunca se usa en runtime del server/cliente.
# Project Settings → API → service_role (secreta, se salta RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — usada únicamente por /api/claude en el servidor. Nunca la
# expongas con el prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Google Cloud — cuenta de servicio para leer Google Sheets desde el botón
# "Actualizar" de Inversiones. Comparte cada hoja con este client_email
# como Lector. Nunca las expongas con el prefijo NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
